# ============================================================================
# VELOPASS - DIGITAL E-CARD, WALLET & QR PAYMENT SYSTEM (.env.example)
# Copy this file to .env and replace placeholder values before running in prod.
# ============================================================================

# Application Environment: development | testing | production
APP_ENV=development
APP_NAME=VeloPass
APP_HOST=127.0.0.1
APP_PORT=5002

# Security Secrets (MUST override with strong random 64-char hex strings in production)
SECRET_KEY=change-this-secret-key-in-production-min-32-bytes
QR_HMAC_SECRET=change-this-qr-signing-secret-in-production-min-32-bytes

# Payment Webhook Integration (SePay / Casso / VietQR Webhook)
# Leave PAYMENT_WEBHOOK_SECRET empty if bank webhook is not yet connected;
# in that mode, webhook endpoint rejects unsigned calls and Admin confirms top-ups manually from bank statements.
PAYMENT_WEBHOOK_PROVIDER=SEPAY_COMPATIBLE
PAYMENT_WEBHOOK_SECRET=

# Prototype 2 — Automated Bank Account Statement Polling & Reconciliation
# Supports: SEPAY_API | CASSO_API | CUSTOM_JSON_API | MANUAL_IMPORT_ONLY
# Runs IN PARALLEL with Manual Admin Top-up Approval!
BANK_SYNC_PROVIDER=SEPAY_API
BANK_SYNC_API_URL=
BANK_SYNC_API_TOKEN=
BANK_SYNC_BACKGROUND_ENABLED=false
BANK_SYNC_INTERVAL_SECONDS=20

# Database Path (SQLite WAL file path; parent folder created automatically)
DATABASE_PATH=data/velopass.db

# Session & Cookie Security
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=24
REMEMBER_ME_DAYS=30

# Default Operational Rules
DEFAULT_FARE_VND=4000
DEFAULT_QR_TTL_SECONDS=90
LOW_BALANCE_THRESHOLD_VND=20000
TOPUP_EXPIRY_MINUTES=30

# CORS Allowed Origins (comma-separated, empty means same-origin only)
CORS_ALLOWED_ORIGINS=

# Initial Bootstrap Admin (used ONLY by `python manage.py create-admin` or dev seed)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@velopass.local
BOOTSTRAP_ADMIN_PASSWORD=
